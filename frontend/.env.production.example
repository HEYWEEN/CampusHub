# 前端生产环境变量模板
# ─────────────────────────────────────────────────────────────
# 用法：cp .env.production.example .env.production 后填值
# Vite 在 npm run build 时自动加载 .env.production
# 前端代码通过 import.meta.env.VITE_XXX 读取
# ─────────────────────────────────────────────────────────────

# 后端 API 基址（如已用反向代理同域，可留空）
VITE_API_BASE_URL=https://api.your-domain.com
