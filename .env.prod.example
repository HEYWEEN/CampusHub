# CampusHub 生产环境变量模板
# ─────────────────────────────────────────────────────────────
# 用法：cp .env.prod.example .env.prod  之后填入真实值
# .env.prod 已在 .gitignore 中（不会提交）
# 由 ./start.sh prod 自动加载并 export 给 Spring Boot
# ─────────────────────────────────────────────────────────────

# ----- 数据库 -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campushub
DB_USERNAME=
DB_PASSWORD=

# ----- 后端服务 -----
SERVER_PORT=8080

# ----- 后续按需扩展（示例）-----
# JWT_SECRET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
