# CampusHub 生产环境变量模板
# ─────────────────────────────────────────────────────────────
# 用法：cp .env.prod.example .env.prod  之后填入真实值
# .env.prod 已在 .gitignore 中（不会提交）
# 由 ./start.sh prod 自动加载并 export 给 Spring Boot
# ─────────────────────────────────────────────────────────────

# ----- 数据库 -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campushub
DB_USERNAME=
DB_PASSWORD=

# ----- 后端服务 -----
SERVER_PORT=8080

# ----- AI 助手（OpenAI-compatible Provider）-----
# deepseek（默认）或 orcarouter；只需填写被选中的 Provider Key
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ORCAROUTER_API_KEY=
# 仅 OrcaRouter 使用；可替换为模型目录中的具体模型 ID
ORCAROUTER_MODEL=orcarouter/auto

# ----- 后续按需扩展（示例）-----
# JWT_SECRET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
